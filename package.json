{
  "name": "m3u-playlist-editor",
  "version": "1.10.0",
  "description": "M3U Playlist Editor - IPTV playlist management REST API",
  "engines": {
    "node": ">=22"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "check": "node scripts/check-syntax.js",
    "test": "cross-env NODE_OPTIONS=--localstorage-file=.node-localstorage jest",
    "test:ci": "cross-env NODE_OPTIONS=--localstorage-file=.node-localstorage jest --runInBand --detectOpenHandles",
    "test:watch": "cross-env NODE_OPTIONS=--localstorage-file=.node-localstorage jest --watch",
    "test:property": "cross-env NODE_OPTIONS=--localstorage-file=.node-localstorage jest --testPathPatterns=property --passWithNoTests",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "seed": "knex seed:run",
    "seed:demo": "node scripts/seed-demo.js",
    "make-admin": "node scripts/make-admin.js",
    "reset-password": "node scripts/reset-password.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "ipaddr.js": "^2.2.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "safe-regex2": "^5.0.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "fast-check": "^3.23.2",
    "jest": "^30.4.2",
    "supertest": "^7.0.0"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.9",
    "brace-expansion": "^5.0.8",
    "babel-plugin-istanbul": "^8.0.0",
    "test-exclude": "^8.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "node",
        "node-addons"
      ]
    },
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/tests/**/*.property.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/\\.claude/",
      "/desktop/"
    ]
  }
}
