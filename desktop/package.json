{
  "name": "m3u-editor-desktop",
  "productName": "M3U Editor",
  "desktopName": "m3u-editor-desktop.desktop",
  "version": "1.11.0",
  "description": "M3U Editor masaüstü uygulaması (Windows ve Linux): IPTV oynatma listelerini bu bilgisayarda düzenleyin.",
  "homepage": "https://github.com/fyildirim-debug/M3uEditor",
  "author": {
    "name": "Furkan YILDIRIM",
    "url": "https://github.com/fyildirim-debug"
  },
  "license": "MIT",
  "private": true,
  "main": "main/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "sync-deps": "node scripts/sync-deps.js",
    "check-deps": "node scripts/sync-deps.js --check",
    "prepare-app": "node scripts/prepare.js",
    "dist": "node scripts/prepare.js --build && electron-builder --publish never",
    "dist:linux": "node scripts/prepare.js --build && electron-builder --linux --publish never",
    "dist:win": "node scripts/prepare.js --build && electron-builder --win --publish never"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "ipaddr.js": "^2.2.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "safe-regex2": "^5.0.0",
    "uuid": "^11.0.5"
  },
  "optionalDependencies": {
    "@embedded-postgres/linux-arm64": "18.7.0-beta.19",
    "@embedded-postgres/linux-x64": "18.7.0-beta.19",
    "@embedded-postgres/windows-x64": "18.7.0-beta.19"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  }
}
