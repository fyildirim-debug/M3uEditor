# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=m3u_playlist_editor
DB_USER=postgres
DB_PASSWORD=postgres

# Security (iki bağımsız değer üretin: openssl rand -hex 32)
JWT_SECRET=BURAYI_DEGISTIR_JWT_SECRET_GECERSIZ
JWT_EXPIRES_IN=15m
CREDENTIAL_ENCRYPTION_KEY=BURAYI_DEGISTIR_ENCRYPTION_KEY_GECERSIZ
# false: mevcut kullanıcılar varken yeni kaydı kapatır; boş kurulumda ilk kullanıcıya izin verir
ALLOW_REGISTRATION=true
# true: özel/yerel ağ adreslerine giden istekleri açar. Yalnızca yerel bir yapay
# zeka sağlayıcısı (Ollama, LM Studio vb.) veya iç ağdaki bir M3U/EPG kaynağı
# kullanılacaksa açın; SSRF korumasını gevşetir.
ALLOW_PRIVATE_NETWORK_URLS=false

# Yapay zeka asistanı
# Sohbet mesajının üst sınırı. Bu değeri aşan metin reddedilmez; otomatik
# olarak dosya ekine dönüştürülüp modele önizlemesi verilir.
AI_MAX_MESSAGE_CHARS=1000000
# Bu uzunluğun üstündeki mesaj gövdesi modele olduğu gibi gitmez, eke taşınır.
AI_INLINE_MESSAGE_CHARS=12000
# Sohbete eklenen tek dosya sınırı ve hesap başına toplam alan.
AI_ATTACHMENT_MAX_BYTES=20971520
AI_ATTACHMENT_QUOTA_BYTES=209715200
# Ek dosyaların diskteki yeri. Boş bırakılırsa UPLOAD_DIR'in kardeşi olur
# (ör. /app/data/logos -> /app/data/ai-attachments), yani aynı birimde kalır.
AI_ATTACHMENT_DIR=
# Zamanlanmış asistan görevleri için izin verilen en kısa aralık (dakika).
AI_MIN_TASK_INTERVAL_MINUTES=15

# Asistanın web araması (yığın içi SearXNG)
# Compose bunu kendiliğinden ayarlar; boş bırakılırsa web arama araçları
# katalogdan düşer ve asistan aramanın kapalı olduğunu bilir.
SEARXNG_URL=http://searxng:8080
# SearXNG'nin kendi oturum anahtarı. Servis dışarı açılmadığı için kritik
# değil ama üretimde rastgele bir değer verin: openssl rand -hex 32
SEARXNG_SECRET=

# Hazır logo kütüphanesi (tv-logo/tv-logos)
# Dosya dizini GitHub'dan günde bir kez çekilip bellekte tutulur. Anonim
# GitHub limiti saatte 60 istektir; paylaşımlı bir IP'de sıkışırsa buraya bir
# token yazın (yalnızca genel okuma yetkisi yeter).
GITHUB_TOKEN=
# Görsellerin servis edildiği CDN kökü. Kendi aynanızı kullanacaksanız değiştirin.
TV_LOGOS_CDN_BASE=
# Dizin adresi. Yalnızca test veya kendi kopyanızı kullanmak için gerekir.
TV_LOGOS_INDEX_URL=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@m3ueditor.com

# App
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
TRUST_PROXY=1
UPLOAD_DIR=./data/logos
MAX_JSON_BODY=25mb
MAX_M3U_BYTES=20971520
MAX_EPG_BYTES=104857600
MAX_XTREAM_BYTES=268435456
MAX_CONCURRENT_IMPORTS=4
IMPORT_JOB_TTL_MS=600000
XTREAM_TOTAL_TIMEOUT_MS=120000
XTREAM_CATEGORY_CONCURRENCY=8
XTREAM_TYPE_CONCURRENCY=2
# Xtream cikisini kullanan oynaticilar kanal basina get_short_epg atar; bu
# deger 15 dakikalik pencerede kullanici adi+IP basina izin verilen istek
# sayisidir. Cok buyuk listelerde yukseltin.
XTREAM_PLAYER_RATE_LIMIT=20000
# Basarisiz kimlik dogrulama tavani. Oynaticilar paralel istek attigi icin
# dar bir deger mesru istemciyi de keser.
XTREAM_FAILURE_RATE_LIMIT=200
NODE_MAX_OLD_SPACE_MB=1536

# Docker container limits. NODE_MAX_OLD_SPACE_MB caps the V8 heap but not
# external Buffers, so keep API_MEM_LIMIT comfortably above it.
API_MEM_LIMIT=2g
DB_MEM_LIMIT=1g
FRONTEND_MEM_LIMIT=256m

# The stack serves plain HTTP. Bind it to loopback and terminate TLS in a
# reverse proxy in front of it (see README).
HTTP_BIND=0.0.0.0
HTTP_PORT=80
