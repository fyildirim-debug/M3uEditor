# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=m3u_playlist_editor
DB_USER=postgres
DB_PASSWORD=postgres

# Security (use two independent random values with at least 32 characters)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
CREDENTIAL_ENCRYPTION_KEY=replace-with-another-long-random-secret
ALLOW_PRIVATE_NETWORK_URLS=false

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@m3ueditor.com

# App
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
TRUST_PROXY=1
UPLOAD_DIR=./data/logos
MAX_JSON_BODY=25mb
MAX_M3U_BYTES=20971520
MAX_EPG_BYTES=104857600
MAX_XTREAM_BYTES=268435456
XTREAM_CATEGORY_CONCURRENCY=8
XTREAM_TYPE_CONCURRENCY=2
NODE_MAX_OLD_SPACE_MB=1536
