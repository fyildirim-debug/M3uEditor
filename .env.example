# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=m3u_playlist_editor
DB_USER=postgres
DB_PASSWORD=postgres

# Security (iki bağımsız değer üretin: openssl rand -hex 32)
JWT_SECRET=BURAYI_DEGISTIR_JWT_SECRET_GECERSIZ
JWT_EXPIRES_IN=15m
CREDENTIAL_ENCRYPTION_KEY=BURAYI_DEGISTIR_ENCRYPTION_KEY_GECERSIZ
ALLOW_PRIVATE_NETWORK_URLS=false

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@m3ueditor.com

# App
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
TRUST_PROXY=1
UPLOAD_DIR=./data/logos
MAX_JSON_BODY=25mb
MAX_M3U_BYTES=20971520
MAX_EPG_BYTES=104857600
MAX_XTREAM_BYTES=268435456
XTREAM_CATEGORY_CONCURRENCY=8
XTREAM_TYPE_CONCURRENCY=2
NODE_MAX_OLD_SPACE_MB=1536

# Docker container limits. NODE_MAX_OLD_SPACE_MB caps the V8 heap but not
# external Buffers, so keep API_MEM_LIMIT comfortably above it.
API_MEM_LIMIT=2g
DB_MEM_LIMIT=1g
FRONTEND_MEM_LIMIT=256m

# The stack serves plain HTTP. Bind it to loopback and terminate TLS in a
# reverse proxy in front of it (see README).
HTTP_BIND=0.0.0.0
HTTP_PORT=80
